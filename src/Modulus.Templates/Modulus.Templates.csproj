<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Embeds the net10.0-only scaffold templates; the project itself has no runtime surface to
         multi-target. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="templates\**" />
    <None Remove="templates\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modulus.Templates.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="templates\**\*" />
    <EmbeddedResource Update="templates\**\*.cs.template" WithCulture="false" />
  </ItemGroup>

</Project>
