<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Strict in CI, tolerant locally: the repo builds warning-clean, keep it that way. -->
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Version is computed per-package by MinVer from the git tag matching that package's prefix.
         Without any matching tag MinVer falls back to 0.0.0-alpha.0.<height>. -->
    <Authors>Adam Wyatt</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/adamwyatt34/Modulus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adamwyatt34/Modulus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Reproducible builds + forensic traceability of shipped binaries -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Package hygiene: every packable, non-test project is validated at pack time, and
       library packages are additionally checked for breaking changes against the last
       released version. A brand-new package has no published baseline yet — it sets
       NoPackageBaseline=true in its csproj until its first release. Bump the baseline
       version as part of each release (see CONTRIBUTING's checklist). -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(PackAsTool)' != 'true' and '$(NoPackageBaseline)' != 'true'">3.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Mechanical public-API tracking for the library packages: RS0016/RS0017 keep
       PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt in lockstep with the real surface,
       so an accidental public-API change fails CI instead of shipping silently. Library
       csprojs opt in with EnforcePublicApi=true. -->
  <ItemGroup Condition="'$(EnforcePublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
