<Project>

  <PropertyGroup>
    <!-- Default for the seven runtime library packages (Mediator[.Abstractions],
         Messaging[.Abstractions], Messaging.RabbitMq, Messaging.AzureServiceBus, Testing) and the
         test suites that cover them: both are LTS (net9.0 left support May 2026, so it's not in
         the set). A project that must single-target (the Cli tool, Templates, the Roslyn
         generators/analyzers/code-fixes which stay netstandard2.0, samples, and the CLI/
         Templates/Generators/Analyzers test suites) sets its own <TargetFramework> in its csproj
         body — the SDK only cross-targets when TargetFrameworks is set AND TargetFramework is
         empty, so a project-level TargetFramework cleanly wins over this default with no
         NETSDK1023 conflict. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Strict in CI, tolerant locally: the repo builds warning-clean, keep it that way. -->
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Version is computed per-package by MinVer from the git tag matching that package's prefix.
         Without any matching tag MinVer falls back to 0.0.0-alpha.0.<height>. -->
    <Authors>Adam Wyatt</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/adamwyatt34/Modulus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adamwyatt34/Modulus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Reproducible builds + forensic traceability of shipped binaries -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Package hygiene (validation + baseline) lives in Directory.Build.targets: it must
       evaluate after each csproj body so per-project opt-outs (NoPackageBaseline,
       IsPackable, IsTestProject) are final. -->

  <!-- Mechanical public-API tracking for the library packages: RS0016/RS0017 keep
       PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt in lockstep with the real surface,
       so an accidental public-API change fails CI instead of shipping silently. Library
       csprojs opt in with EnforcePublicApi=true. -->
  <ItemGroup Condition="'$(EnforcePublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
